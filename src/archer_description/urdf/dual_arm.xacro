<?xml version="1.0"?>
<robot name="archer_dual_arm_gp80"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 两臂基座中心的左右间距，单位：米。 -->
  <xacro:arg name="base_distance" default="0.42"/>

  <!-- 两侧基座高度及朝向，可分别调整。 -->
  <xacro:arg name="left_base_height" default="0.0"/>
  <xacro:arg name="right_base_height" default="0.0"/>

  <xacro:arg name="left_base_rpy" default="0 0 1.5707963267948966"/>
  <xacro:arg name="right_base_rpy" default="0 0 1.5707963267948966"/>

  <!-- 保留已在单臂阶段检查的夹爪安装参数。 -->
  <xacro:arg name="left_gripper_mount_xyz" default="0 0 0"/>
  <xacro:arg name="left_gripper_mount_rpy" default="0 0 0"/>

  <xacro:arg name="right_gripper_mount_xyz" default="0 0 0"/>
  <xacro:arg name="right_gripper_mount_rpy" default="0 0 0"/>

  <xacro:include
    filename="$(find archer_description)/urdf/archer_arm.xacro"/>

  <xacro:include
    filename="$(find archer_description)/urdf/gp80.xacro"/>

  <xacro:property
    name="base_distance"
    value="$(arg base_distance)"/>

  <!-- 共同坐标系位于两臂基座中心之间。 -->
  <link name="world"/>

  <!-- ==================== 左臂 ==================== -->

  <xacro:archer_arm prefix="left_"/>

  <joint name="left_world_to_base" type="fixed">
    <parent link="world"/>
    <child link="left_base_link"/>

    <origin
      xyz="${-float(base_distance) / 2.0} 0 $(arg left_base_height)"
      rpy="$(arg left_base_rpy)"/>
  </joint>

  <xacro:gp80
    prefix="left_"
    parent="left_flange"
    mount_xyz="$(arg left_gripper_mount_xyz)"
    mount_rpy="$(arg left_gripper_mount_rpy)"/>

  <!-- ==================== 右臂 ==================== -->

  <xacro:archer_arm prefix="right_"/>

  <joint name="right_world_to_base" type="fixed">
    <parent link="world"/>
    <child link="right_base_link"/>

    <origin
      xyz="${float(base_distance) / 2.0} 0 $(arg right_base_height)"
      rpy="$(arg right_base_rpy)"/>
  </joint>

  <xacro:gp80
    prefix="right_"
    parent="right_flange"
    mount_xyz="$(arg right_gripper_mount_xyz)"
    mount_rpy="$(arg right_gripper_mount_rpy)"/>

</robot>