<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Archer-Y6 六轴机械臂模型。

    prefix：左右臂名称前缀，例如 left_ 或 right_。
    网格、惯性、关节原点和限位来自现有 archer_y6.urdf。
    所有长度单位为米，角度单位为弧度。
    用户授权J2/J4下限增加0.005rad工程余量，不修改控制器固件限位。
  -->

  <xacro:macro name="archer_link"
               params="prefix name mass com
                       ixx ixy ixz iyy iyz izz
                       rgba">

    <link name="${prefix}${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
          iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://archer_description/meshes/${name}.STL"/>
        </geometry>
        <material name="${prefix}${name}_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://archer_description/meshes/${name}.STL"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="archer_joint"
               params="prefix name parent child
                       xyz axis lower upper effort velocity">

    <joint name="${prefix}${name}" type="revolute">
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${child}"/>
      <axis xyz="${axis}"/>
      <limit
        lower="${lower}"
        upper="${upper}"
        effort="${effort}"
        velocity="${velocity}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="archer_arm" params="prefix">

    <xacro:archer_link
      prefix="${prefix}" name="base_link"
      mass="0.74808813"
      com="-0.00102300 0.00000247 0.03072811"
      ixx="0.00067487"
      ixy="0.00000015"
      ixz="0.00001570"
      iyy="0.00072138"
      iyz="0.00000002"
      izz="0.00085851"
      rgba="0.64706 0.64706 0.64706 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_1"
      mass="0.24534004"
      com="0.00699383 -0.00349145 0.02258835"
      ixx="0.00041841"
      ixy="0.00000916"
      ixz="-0.00003996"
      iyy="0.00020839"
      iyz="0.00001939"
      izz="0.00039758"
      rgba="1 1 1 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_2"
      mass="1.50114648"
      com="0.00010132 -0.00106108 0.13135856"
      ixx="0.02099825"
      ixy="-0.00000109"
      ixz="0.00002691"
      iyy="0.02058533"
      iyz="0.00001151"
      izz="0.00109630"
      rgba="1 1 1 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_3"
      mass="1.20436025"
      com="-0.0537698 -0.00154368 0.16022395"
      ixx="0.0109925"
      ixy="0.00002895"
      ixz="0.00116056"
      iyy="0.01062105"
      iyz="0.0000207"
      izz="0.00160822"
      rgba="1 1 1 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_4"
      mass="0.64362417"
      com="-0.05755135 -0.00169321 0.05608527"
      ixx="0.00107705"
      ixy="0.00005233"
      ixz="0.00044728"
      iyy="0.00125938"
      iyz="-0.00005024"
      izz="0.00111793"
      rgba="1 1 1 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_5"
      mass="0.40354464"
      com="0.05285354 0.00000275 0.00262604"
      ixx="0.00018496"
      ixy="-0.00000003"
      ixz="0.0000026"
      iyy="0.00023176"
      iyz="0.00000002"
      izz="0.00022147"
      rgba="1 1 1 1"/>

    <xacro:archer_link
      prefix="${prefix}" name="link_6"
      mass="0.00538588"
      com="-0.00066764 0 0.00388966"
      ixx="0.00000055"
      ixy="0"
      ixz="0"
      iyy="0.00000061"
      iyz="0"
      izz="0.0000011"
      rgba="0.1098 0.1098 0.1098 1"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_1"
      parent="base_link" child="link_1"
      xyz="0 0 0.06645"
      axis="0 0 1"
      lower="-2.79" upper="2.79"
      effort="6" velocity="6"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_2"
      parent="link_1" child="link_2"
      xyz="0.02 0 0.045"
      axis="0 1 0"
      lower="-1.575" upper="2.09"
      effort="6" velocity="6"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_3"
      parent="link_2" child="link_3"
      xyz="0 0 0.264"
      axis="0 1 0"
      lower="0" upper="3.14"
      effort="6" velocity="6"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_4"
      parent="link_3" child="link_4"
      xyz="-0.06 0 0.245"
      axis="0 1 0"
      lower="-1.575" upper="1.57"
      effort="3" velocity="3"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_5"
      parent="link_4" child="link_5"
      xyz="-0.0553 0 0.0702"
      axis="-1 0 0"
      lower="-1.55" upper="1.55"
      effort="3" velocity="3"/>

    <xacro:archer_joint
      prefix="${prefix}" name="joint_6"
      parent="link_5" child="link_6"
      xyz="0.0552 0 0.02895"
      axis="0 0 1"
      lower="-2.96" upper="2.96"
      effort="3" velocity="3"/>

    <!--
      法兰参考坐标系：与 link_6 相差8mm。
      它不是已标定的夹爪 TCP，后续根据工具模型确定 TCP。
    -->
    <link name="${prefix}flange"/>

    <joint name="${prefix}flange_joint" type="fixed">
      <parent link="${prefix}link_6"/>
      <child link="${prefix}flange"/>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
