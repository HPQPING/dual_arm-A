<?xml version="1.0"?>
<robot name="archer_single_arm_gp80"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="side" default="left"/>

  <!-- 沿用已检查的夹爪安装变换。 -->
  <xacro:arg name="gripper_mount_xyz" default="0 0 0"/>
  <xacro:arg name="gripper_mount_rpy" default="0 0 0"/>

  <!-- TCP 位置在夹爪模型坐标系中定义。 -->
  <xacro:arg name="tcp_xyz" default="0 0 0.147021696"/>
  <xacro:arg name="show_tcp" default="true"/>

  <xacro:include
    filename="$(find archer_description)/urdf/archer_arm.xacro"/>

  <xacro:include
    filename="$(find archer_description)/urdf/gp80.xacro"/>

  <xacro:property name="side" value="$(arg side)"/>
  <xacro:property name="prefix" value="${side + '_'}"/>

  <link name="world"/>

  <xacro:archer_arm prefix="${prefix}"/>

  <joint name="${prefix}world_to_base" type="fixed">
    <parent link="world"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:gp80
    prefix="${prefix}"
    parent="${prefix}flange"
    mount_xyz="$(arg gripper_mount_xyz)"
    mount_rpy="$(arg gripper_mount_rpy)"
    tcp_xyz="$(arg tcp_xyz)"
    show_tcp="$(arg show_tcp)"/>

</robot>