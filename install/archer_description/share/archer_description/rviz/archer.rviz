Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 0.1
      Color: 160; 160; 160
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: world
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/RobotModel
      Name: Archer
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Left Gripper Coordinates
      Enabled: true
      Topic:
        Value: /left/gripper_markers
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Right Gripper Coordinates
      Enabled: false
      Topic:
        Value: /right/gripper_markers
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 10
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: world
      Distance: 1.8
      Pitch: 0.4
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.35
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1200
  Height: 800